# ─── Azure AI Foundry ────────────────────────────────────────────────────────
# Shared key for every model deployed on this resource
# Azure portal → your resource → Keys and Endpoint → Key 1 or Key 2
AZURE_AI_API_KEY=your-key-here

# Claude (Anthropic native API via Azure AI Foundry)
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com

# GPT (Azure AI Foundry project-scoped OpenAI endpoint)
AZURE_OPENAI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1

# ─── Quota (optional — hardcoded defaults apply if unset) ───────────────────
# MONTHLY_BUDGET_USD=3.00
# PRICE_GPT_MINI=0.15,0.60
# PRICE_GPT_CODEX=1.75,14.00
# PRICE_CLAUDE_SONNET=3.00,15.00
# PRICE_DEEPSEEK=0.14,0.28

# ─── Feature flags (optional — default on) ──────────────────────────────────
# FEATURE_FILE_UPLOAD=true
# FEATURE_PPT_EXPORT=true
